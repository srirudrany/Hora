  "type": {
    "families": {
      "sanskrit-display": "Tiro Devanagari Sanskrit (Google Fonts) — Devanagari and IAST, italic for Sanskrit terms",
      "tamil": "Tiro Tamil (Google Fonts)",
      "ui": "Noto Sans (full IAST diacritic coverage)",
      "figures": "IBM Plex Mono, tabular numerals (digits only; lacks IAST)"
    },
    "scale_px_at_1280": { "hero-devanagari": 128, "chapter-devanagari": 104, "title-iast": 46, "caption": 29, "readout-big": 64, "anga-name": 25, "body": 17, "label-caps": 13 },
    "rules": ["Sanskrit terms in IAST italic, gold-soft", "Caps labels 13px, letter-spacing .12em, muted", "Times always 'h:mm am' plus nāḻigai 'NN:VV' in mono", "Ordinals may use Devanagari digits ०–९"]
  },
  "radius": { "chip": 10, "panel": 14, "pill": 999, "tile": 9 },
  "spacing": { "stage-gutter": 30, "panel-pad": "20px 24px", "row-pad": "7px 12px" },
  "motion": { "principle": "nothing snaps on the hour; limbs move continuously with the sky", "fade": "0.6–0.8 s", "caption-in-out": "0.35 s" }
