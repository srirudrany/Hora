    "semantic": { "rahu-kalam": "#D9483E", "yamagandam": "#8F6BB8", "kulikai": "#C07A43", "day-arc": "#6B4D14", "night-arc": "#0F1A4D", "sukla": "#4E5E92", "krsna": "#141A3A" },
    "nakshatra-nature": { "dhruva": "#3E7F7A", "cara": "#3C5FA8", "ksipra": "#C9962F", "mrdu": "#A0698F", "ugra": "#A63A32", "tiksna": "#6B3A7E", "misra": "#6E7488" },
    "tithi-family": { "Nanda": "#3F86A8", "Bhadra": "#4F9D7A", "Jaya": "#C9A13D", "Rikta": "#D9483E", "Purna": "#DCCFAE" },
    "karana": { "Bava": "#34508E", "Balava": "#3C67A0", "Kaulava": "#3B7C8E", "Taitila": "#3E8A77", "Gara": "#5A7F4E", "Vanij": "#7F7A44", "Visti": "#D9483E", "Sakuni": "#9A5A2E", "Catuspada": "#B06D38", "Naga": "#C78544", "Kimstughna": "#D39A55" },
